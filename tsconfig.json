{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
    "noEmit": true, "types": ["node", "vite/client"], "jsx": "preserve"
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "electron.vite.config.ts", "vite.wails.config.mts", "tests/**/*.ts", "vitest.config.mts"]
}
